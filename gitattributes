# Treat ECU dumps as binary: no diffing, no line-ending conversion.
*.bin   binary
*.ori   binary
*.mod   binary
*.hex   binary
*.bdm   binary

# Text files: normalize line endings.
*.md    text eol=lf
*.txt   text eol=lf
*.rs    text eol=lf
.gitattributes text eol=lf

# Optional: store large binaries with Git LFS instead.
# Uncomment these lines (and run `git lfs install`) before adding the files.
# *.bin filter=lfs diff=lfs merge=lfs -text
